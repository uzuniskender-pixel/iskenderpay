// firestore.rules — iskenderpay (KAYIT AMACLI / record-only)
// Bu dosya GitHub Pages tarafindan deploy EDILMEZ. Aktif kural Firebase
// Console'da (proje: iskenderpay-a23d1) yonetilir. Burada referans/yedek olarak
// tutulur ki gelecekte kuralin ne oldugu kod tarafindan da gorulebilsin.
//
// DOGRULAMA (30 May 2026, #3 PASS): Kural ACIK DEGIL. Tum dokumanlara erisim
// "giris yapmis VE email == uzuniskender@gmail.com" sartina bagli. Email,
// Google'in dogruladigi kimlik jetonundan gelir -> taklit edilemez.
//   - Baska Google hesabi -> reddedilir (email uyusmuyor).
//   - Girissiz -> reddedilir (request.auth == null).
// Kimlik-bazli (rol-bazli DEGIL), tek-kullanici modeline uygun. wrappedKey/
// pinHash baskasinca okunamaz (cevrimdisi PIN brute-force kapali), vandalizm
// kapali. Tek dikkat: email sabit yazili -> Google e-postasi degisirse veya
// ikinci hesap/kullanici eklenirse bu kural elle guncellenmeli.
//
// NOT: Veri modeli tek duz koleksiyon 'users', dokuman ID'leri:
//   users/{uid}_{planId}  -> { data (E2E sifreli), updatedAt, pinHash }
//   users/{uid}_meta      -> { wrappedKey }
// (Alt-koleksiyon yok; uid dokuman ID onekidir, path segmenti degil.)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "uzuniskender@gmail.com";
    }
  }
}
